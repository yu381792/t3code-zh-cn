#!/bin/sh
# T3 local ACP entry, using current OpenCodex model routes.
export PATH="/Users/yu/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
case "${T3_RUNTIME_MODE:-}" in
  full-access) export DSH_PERMISSION_MODE="danger-full-access" ;;
  approval-required|auto-accept-edits|auto) export DSH_PERMISSION_MODE="workspace-write" ;;
  "") export DSH_PERMISSION_MODE="danger-full-access" ;;
  *) echo "Unsupported T3 runtime mode: $T3_RUNTIME_MODE" >&2; exit 64 ;;
esac
entry_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
model_patch=$(node "$entry_dir/sync-models.mjs") || exit 1
# Apply model routes last while preserving caller overlays for presets and tools.
exec /Users/yu/.npm-global/bin/dsh --profile t3-acp "$@" --patch "$model_patch"
